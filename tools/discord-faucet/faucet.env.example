# /etc/finalis-faucet.env (chmod 600): read by finalis-faucet.service and finalis-faucet-sweep.service.

# Discord: bot token, server (guild) id, the channel /faucet works in, and who to ping on failures.
FAUCET_DISCORD_TOKEN=
FAUCET_GUILD_ID=
FAUCET_CHANNEL_ID=
FAUCET_ADMIN_USER_ID=

# Node on this machine.
FAUCET_RPC=http://127.0.0.1:19544/rpc
FAUCET_CLI=/home/ubuntu/finalis-core/build/finalis-cli
FAUCET_NODE_DB=/home/ubuntu/.finalis/testnet

# The faucet's own key (not the validator key) and its address.
FAUCET_KEY_FILE=/home/ubuntu/finalis-faucet/faucet.json
FAUCET_KEY_PASS=
FAUCET_ADDRESS=

# Where requests are kept.
FAUCET_DB=/home/ubuntu/finalis-faucet/faucet.sqlite

# Sweep: the validator key whose rewards move to the faucet every hour.
SWEEP_VALIDATOR_KEY_FILE=/home/ubuntu/.finalis/testnet/keystore/validator.json

# Optional: fee buffer added to each bond (units; default 1 FLS) and the faucet's income per block,
# used only for the ETA shown to users (default 5.75 FLS).
#FAUCET_FEE_BUFFER_UNITS=100000000
#FAUCET_INCOME_UNITS_PER_BLOCK=575000000
